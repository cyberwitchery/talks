#!/bin/sh
# pulls a cable out of the running lab, the way someone would by hand: on one of
# its nodes, delete the port's end of the link. netbox is not told.
. "$(dirname "$0")/common.sh"
label="${1:?usage: ./pull-cable <cable label, e.g. c1>}"

# the cable's a-side end, from the lab model deploy wrote
end=$(jq -r --arg label "$label" '
  .objects as $o
  | ($o[] | select(.type == "dcim.cable" and .key.label == $label) | .attrs.a_terminations[0]) as $if
  | ($o[] | select(.uid == $if)) as $i
  | ($o[] | select(.uid == $i.attrs.device) | .key.name) + " " + $i.attrs.name' lab.json)
[ -n "$end" ] || { echo "no cable $label in lab.json; run ./deploy first" >&2; exit 1; }
node=${end% *}
port=${end#* }

printf '\n\033[1mpull cable %s at %s %s\033[0m\n' "$label" "$node" "$port"
lab sudo docker exec "clab-denog-$node" ip link delete "$port"
