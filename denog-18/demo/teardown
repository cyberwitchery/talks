#!/bin/sh
# empties the lab and the monitoring, and forgets alembic's state. netbox is
# left alone.
#
#   LAB_HOST     ssh host that runs containerlab (default: denog-lab)
#   LAB_KEY      ssh identity for it, when the ssh config does not set one
set -eu
cd "$(dirname "$0")"
LAB_HOST="${LAB_HOST:-denog-lab}"
topology=labs/denog/topology.clab.yml

ssh -T -o BatchMode=yes ${LAB_KEY:+-i "$LAB_KEY" -o IdentitiesOnly=yes} "$LAB_HOST" \
  "(cd denog-monitoring 2>/dev/null && docker compose down >/dev/null 2>&1); sudo containerlab destroy -t $topology --cleanup >/dev/null 2>&1; sudo rm -f $topology; mkdir -p labs/denog; rm -f denog-monitoring/targets/*.json" \
  || { echo "cannot reach $LAB_HOST; set LAB_KEY, or an IdentityFile in the ssh config" >&2; exit 1; }
rm -rf .alembic netbox.json lab.json plan.json observed.json drift.json monitoring.json
echo "the lab is empty; next: ./deploy"
